{
  "name": "@assay/mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server for the Assay NAV oracle on X Layer.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "bin": {
    "assay-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts",
    "start": "node dist/index.js",
    "dev": "node src/index.ts",
    "prepublishOnly": "npm run build",
    "relink": "pnpm install --force"
  },
  "dependencies": {
    "@assay/sdk": "file:../sdk",
    "@modelcontextprotocol/sdk": "^1.18.0",
    "viem": "^2.37.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
